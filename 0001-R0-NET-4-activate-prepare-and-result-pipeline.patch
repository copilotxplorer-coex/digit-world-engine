From 8a07a4fe73912fb29a45c9c6119de3bef8e57121 Mon Sep 17 00:00:00 2001
From: CopilotExplorer <copilotexplorer@proton.me>
Date: Thu, 12 Nov 2026 12:32:56 +0800
Subject: [PATCH] R0-NET-4 activate prepare and result pipeline

---
 region_runtime/http_central.py | 121 ++++++++++++++++++++++++++++++---
 1 file changed, 113 insertions(+), 8 deletions(-)

diff --git a/region_runtime/http_central.py b/region_runtime/http_central.py
index 1beca1b..0a22f64 100644
--- a/region_runtime/http_central.py
+++ b/region_runtime/http_central.py
@@ -3,6 +3,7 @@ import time
 from http.server import BaseHTTPRequestHandler, HTTPServer
 
 from region_runtime.store import RegionStore
+from region_runtime.contract import signed
 
 
 class CentralApi(HTTPServer):
@@ -122,21 +123,125 @@ def serve(
 
                     snapshot = store.snapshot()
 
+                    envelope = signed(
+                        node_keys["A"],
+                        {
+                            "node_id": node_id,
+                            "epoch": snapshot["epoch"] + 1,
+                            "ttl": 30,
+                        },
+                    )
+
                     return self.reply(
                         200,
                         {
                             "ok": True,
-                            "result": {
-                                "node_id": node_id,
-                                "epoch": snapshot[
-                                    "epoch"
-                                ]
-                                + 1,
-                                "ttl": 30,
-                            },
+                            "result": envelope,
+                        },
+                    )
+
+                #
+                # ACTIVATE
+                #
+                if action == "activate":
+                    node_id = body["node_id"]
+                    ready = body["ready"]
+                    ttl = body.get("ttl", 30)
+
+                    response = store.grant(
+                        node_id,
+                        ready,
+                        ttl,
+                    )
+
+                    return self.reply(
+                        200,
+                        {
+                            "ok": True,
+                            "result": response,
+                        },
+                    )
+
+
+                #
+                # PREPARE
+                #
+                if action == "prepare":
+                    proposal = body["proposal"]
+
+                    response = store.prepare(
+                        proposal["operation_id"],
+                        proposal["commands"],
+                    )
+
+                    return self.reply(
+                        200,
+                        {
+                            "ok": True,
+                            "result": response,
+                        },
+                    )
+
+
+                #
+                # RESULT
+                #
+                if action == "result":
+                    node_id = body["node_id"]
+                    result = body["result"]
+
+                    response = store.result(
+                        node_id,
+                        result,
+                    )
+
+                    return self.reply(
+                        200,
+                        {
+                            "ok": True,
+                            "result": response,
+                        },
+                    )
+
+                #
+                # VERIFY
+                #
+                if action == "verify":
+                    proposal = body["proposal"]
+                    results = body["results"]
+
+                    response = store.verify(
+                        proposal,
+                        results,
+                    )
+
+                    return self.reply(
+                        200,
+                        {
+                            "ok": True,
+                            "result": response,
+                        },
+                    )
+
+                #
+                # COMMIT
+                #
+                if action == "commit":
+                    operation_id = body["operation_id"]
+
+                    response = store.commit(
+                        operation_id,
+                    )
+
+                    return self.reply(
+                        200,
+                        {
+                            "ok": True,
+                            "result": response,
                         },
                     )
 
+
                 #
                 # STATUS
                 #
